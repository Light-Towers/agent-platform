{
  "_note": "复杂任务级黄金测试集：每条 = 一个用户提示词 → 展开为多端点编排。断言只锁『可达性 + 响应结构(schema)』，不锁具体值，免疫数据漂移。令牌复用 live.manifest.json 的 jwt_files。",
  "base_url": "http://<internal-ip>",
  "tasks": [
    {
      "id": "A.venue-health",
      "prompt": "帮我把当前默认展会的运营状况体检一下——报馆、展位、撤展、车证、施工图各到什么程度，哪里卡住了？",
      "jwt": "default",
      "intent": "聚合 9 个 builder 端点，评估默认展会运营健康度",
      "steps": [
        {
          "label": "展会列表",
          "method": "GET",
          "path": "/company-builder/api/builder/home/h5/exhibition/getExhibitionListByProject",
          "expect_list": true
        },
        {
          "label": "展位完工",
          "method": "GET",
          "path": "/company-builder/api/builder/home/page/getBoothCompleted",
          "expect_keys": [
            "allBoothCount",
            "completedBoothCount",
            "unFinishedBoothCount"
          ]
        },
        {
          "label": "待办统计",
          "method": "GET",
          "path": "/company-builder/api/builder/home/page/backlog",
          "expect_keys": [
            "contractorAuditCount"
          ]
        },
        {
          "label": "展位概览",
          "method": "GET",
          "path": "/company-builder/api/builder/home/page/booth",
          "expect_keys": [
            "allBoothCount",
            "allBoothUseCount"
          ]
        },
        {
          "label": "面积统计",
          "method": "GET",
          "path": "/company-builder/api/builder/home/statistic/boothStatistic",
          "expect_keys": [
            "totalArea",
            "useTotalArea"
          ]
        },
        {
          "label": "报馆列表",
          "method": "GET",
          "path": "/company-builder/api/builder/home/contractor/page",
          "expect_list": true
        },
        {
          "label": "撤展",
          "method": "GET",
          "path": "/company-builder/api/builder/home/boothRemoval/page",
          "expect_list": true
        },
        {
          "label": "车证",
          "method": "GET",
          "path": "/company-builder/api/builder/home/carCert/page",
          "expect_list": true
        },
        {
          "label": "施工图完工",
          "method": "GET",
          "path": "/company-builder/api/builder/home/h5/work-drawing/getBoothCompleted",
          "expect_keys": [
            "allBoothCount",
            "completedBoothCount"
          ]
        }
      ]
    },
    {
      "id": "B.exhibition-ops",
      "prompt": "看下『2025第二十届大河国际珠宝展』的展位地图统计、车证和撤展情况。",
      "jwt": "default",
      "intent": "先取展会 id 带 exhibitionId 查上下文端点",
      "steps": [
        {
          "label": "地图统计",
          "method": "GET",
          "path": "/company-builder/api/builder/home/booth/map/boothStatistics",
          "params": {
            "exhibitionId": "1963526156780019713"
          },
          "expect_dict": true
        },
        {
          "label": "车证",
          "method": "GET",
          "path": "/company-builder/api/builder/home/carCert/page",
          "params": {
            "exhibitionId": "1963526156780019713",
            "page": 1,
            "pageSize": 10
          },
          "expect_list": true
        },
        {
          "label": "撤展",
          "method": "GET",
          "path": "/company-builder/api/builder/home/boothRemoval/page",
          "params": {
            "exhibitionId": "1963526156780019713",
            "page": 1,
            "pageSize": 10
          },
          "expect_list": true
        }
      ]
    },
    {
      "id": "D.my-exhibitor-todo",
      "prompt": "汇总我公司当前参展的待办——报名到哪一步、证件、论文集、产品发布各什么进度，整理成清单。",
      "jwt": "site",
      "intent": "/site 门户：company + operation 跨服务聚合",
      "steps": [
        {
          "label": "报名信息",
          "method": "GET",
          "path": "/company-company/api/company/site/exhibitor/page",
          "params": {
            "page": 1,
            "pageSize": 10
          },
          "expect_list": true
        },
        {
          "label": "报名流程",
          "method": "GET",
          "path": "/company-company/api/company/site/exhibitor/task-steps",
          "expect_keys": [
            "currentIndex",
            "currentCode",
            "nodes"
          ]
        },
        {
          "label": "证件",
          "method": "POST",
          "path": "/company-company/api/company/site/certificate/page",
          "params": {
            "page": 1,
            "pageSize": 10
          },
          "expect_keys": [
            "pageInfo"
          ]
        },
        {
          "label": "论文集",
          "method": "POST",
          "path": "/company-company/api/company/site/proceedings/query",
          "params": {
            "page": 1,
            "pageSize": 10
          },
          "expect_dict": true
        },
        {
          "label": "个人统计",
          "method": "POST",
          "path": "/company-company/api/company/site/userApplyMessage/getMyStatistics",
          "params": {},
          "expect_keys": [
            "companyId",
            "companyName",
            "authStatus"
          ]
        },
        {
          "label": "观众报名",
          "method": "POST",
          "path": "/company-operation/api/operation/site/audience/page",
          "params": {
            "page": 1,
            "pageSize": 10
          },
          "expect_list": true
        }
      ]
    },
    {
      "id": "E.batch-audit-contractor",
      "mode": "hitl",
      "prompt": "把报馆列表里未审核的搭建商申请批量通过。",
      "note": "写操作：skill 红线规定不得自主执行——须先展示精确请求、等用户显式确认。故本任务不自动执行，仅登记其编排计划。",
      "planned_request": {
        "method": "POST",
        "path": "/company-builder/api/builder/home/contractor/audit",
        "body": {
          "ids": [
            "<报馆id>"
          ],
          "auditStatus": "<通过码>"
        }
      }
    }
  ]
}
