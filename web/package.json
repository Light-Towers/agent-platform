{
  "name": "agent-platform-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "agent_server 的托管前端（挂在 /ui，产物进镜像）。工程约束见 docs/plans/plan-web-frontend-minimal-core-2026-10-29.md 与 web/README.md。",
  "engines": {
    "node": ">=22.12.0"
