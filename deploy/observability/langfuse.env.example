# Langfuse 观测栈配置项清单（**只有名字和生成方式，没有任何值**）
#
# 用法（在 126 上）：本文件不直接用。按下面命令在 126 上现造一份 600 权限的 env 文件，
# 值只在"126 的 env 文件 ↔ k8s Secret"之间流动，不进仓库、不进 argv、不进聊天。
#
#   umask 077
#   envf=/root/langfuse-obs.env
#   : > "$envf"                      # 先落成空文件再写，避免创建瞬间的宽权限窗口
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' )"
#     echo "CLICKHOUSE_USER=langfuse"
#     echo "CLICKHOUSE_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' )"
#     echo "REDIS_AUTH=$(openssl rand -base64 24 | tr -d '/+=' )"
#     echo "MINIO_ROOT_USER=langfuse"
#     echo "MINIO_ROOT_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' )"
#     echo "LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)"
#     echo "LANGFUSE_SALT=$(openssl rand -base64 32)"
#     echo "LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)"   # 必须 64 位 hex
#     echo "LANGFUSE_NEXTAUTH_URL=http://<126 IP>:3000"
#     echo "LANGFUSE_INIT_ORG_ID=org-$(uuidgen | tr A-Z a-z)"
#     echo "LANGFUSE_INIT_PROJECT_ID=proj-$(uuidgen | tr A-Z a-z)"
#     echo "LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-$(uuidgen | tr A-Z a-z)"
#     echo "LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(uuidgen | tr A-Z a-z)"
#     echo "LANGFUSE_INIT_USER_EMAIL=ops@<公司域>"
#     echo "LANGFUSE_INIT_USER_PASSWORD=$(openssl rand -base64 18)"
#   } > "$envf"
#   chmod 600 "$envf"; stat -c "%a %U:%G %n" "$envf"          # 期望 600 root:root
#
# 之后 `langfuse.sh start --env-file "$envf"` 起栈；
# 其中 LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY 这两个值还要经 stdin
# 写进 k8s Secret（`observability-keys`），deployment 用 secretKeyRef 引用。
#
# 配置项 → 去向（这是本文件唯一要回答的问题）
# ------------------------------------------------
# POSTGRES_PASSWORD            栈内 lf-langfuse-db，不出宿主机
# CLICKHOUSE_USER/PASSWORD     栈内 lf-clickhouse
# REDIS_AUTH                   栈内 lf-valkey
# MINIO_ROOT_USER/PASSWORD     栈内 lf-minio
# NEXTAUTH_SECRET/SALT/ENCRYPTION_KEY  栈内 lf-langfuse{,-worker}
# NEXTAUTH_URL                 必须是实例 IP（Pod 里 localhost 指向 Pod 自己）
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY   → k8s ConfigMap? 否：Secret observability-keys/LANGFUSE_PUBLIC_KEY
# LANGFUSE_INIT_PROJECT_SECRET_KEY   → Secret observability-keys/LANGFUSE_SECRET_KEY
# LANGFUSE_HOST（应用侧，不在本栈）   → ConfigMap agent-platform-config = http://<126 IP>:3000
