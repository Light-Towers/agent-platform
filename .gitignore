# === 以. 开头的文件（需显式保留的点文件用 ! 排除） ===
.*/
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.env.example
!.gitattributes
# === 机器专属脚本配置（不提交，避免泄露本机路径） ===
scripts/link-skills.local.py
scripts/.zhipin_lastrun
# === 运行时状态（不提交） ===
state/*.db
state/probe-dump.json
state/rss-last-check.json
state/github-stars-last-check.json
# === 结构化数据层（SQLite 真相源本地化 + 文本导出进 git 同步） ===
data/*.db
!data/exports/
!data/exports/*.json
data/*.json
data/*.csv
# === Obsidian ===
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
