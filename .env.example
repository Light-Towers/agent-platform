# ===== agent-platform 环境变量模板 =====
# 复制为 .env 后填值；切勿提交真实 .env

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
# 启用后所有接口需 X-API-Key 头；同时忽略客户端传入的 thread_id（防会话劫持）
API_KEY=
# 会话身份不再从 API_KEY 派生（B7b 已拆三条「凭据→摘要」链）：启用鉴权时取
# 服务端断言的主体（见下方 SINGLE_TENANT / 验签公钥），历史旧格式会话由
# scripts/migrate_thread_identity.py 枚举式重挂（无需任何密钥参与）。

# --- 租户身份断言（ADR-0007 A3/A4；均走密钥库/挂载，真实值绝不提交）---
# 部署级令牌：既无验签公钥又未声明 SINGLE_TENANT 且 DEPLOY_ENFORCE_IDENTITY=true → 拒绝启动。
DEPLOY_ENFORCE_IDENTITY=false      # 生产置 true 开启 fail-fast；开发/测试默认 false
SINGLE_TENANT=                     # 单租户部署显式声明（非空即绑定该租户，封死"未配key不校验"旁路）
# 验签公钥 JSON {"<kid>": "<PEM>"}（可多把并存支持轮转；子服务/网关验签用，公钥本身可公开）
TENANT_JWT_PUBLIC_KEYS_FILE=
# 签发私钥（仅 issuer=网关持有！绝不下发子服务，绝不进仓库）
TENANT_JWT_PRIVATE_KEY_FILE=
TENANT_JWT_ISSUER=agent-gateway
TENANT_JWT_AUDIENCE=agent-platform
TENANT_JWT_CLOCK_SKEW=60
TENANT_JWT_MAX_TTL_S=3600
TENANT_JWT_ENFORCE=false           # true：无凭据请求 401（灰度末硬切换）；false=observe 放行
# 网关→子服务内部签名头（HMAC-SHA256，共享对称密钥，独立于 API_KEY）
INTERNAL_HMAC_KEY_FILE=
INTERNAL_HEADER_MAX_AGE_S=300
TENANT_HEADER_ENFORCE=false        # A4 观测期软模式；A6 灰度末切 true（fail-closed 拒缺失头）

# --- 存储（留空则以内存模式运行，仅开发用，无持久化） ---
# PostgreSQL + pgvector，承载 checkpoint / RAG 分块 / 长期记忆 / 语义缓存 / SQL 训练数据
DATABASE_URL=postgresql://agent:agent_platform_dev@localhost:5432/agent_platform
# 内核 pg 记忆/联邦池专用（WS-5）：缺省回退 DATABASE_URL；
# 旧名 DEEPAGENTS_DATABASE_URL 兼容一个小版本（命中时触发弃用警告）
# AGENT_PLATFORM_DATABASE_URL=
# 向量维度由 Embedding Provider 自动派生（bge-small-zh=512, bge-m3=1024）。
# 仅当使用 mock 模式或需要显式覆盖时才需设置 EMBEDDING_DIM。
# EMBEDDING_DIM=512
# P2.2：deepagents 长期记忆 store 专用连接串（pgvector 语义记忆，跨会话语义检索）。
# 留空则 deepagents 用 InMemoryStore（重启丢，开发态）。生产需配独立 PG（或复用 DATABASE_URL）。
# 索引维度由 agent-core embedder 动态派生（get_embedder().dim）。
STORE_POSTGRES_DSN=

# --- LLM（OpenAI 兼容协议；留空则以无 LLM 模式运行，路由走启发式） ---
# 权威名：LLM_API_KEY / LLM_BASE_URL（全平台统一，federation 与 knowledge-service 均读此名）。
# 兼容别名：OPENAI_API_KEY / OPENAI_BASE_URL 仍可用（当 LLM_* 未设置时回退），便于平滑迁移。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# --- 换 LLM 提供方时要改的三行（2026-10-13 三家实测，值只到这里，密钥一律留空） ---
# 结论：`tools`/function_calling 是三家唯一全绿的出参形态（11/11 个模型×提供方组合合规）；
#       `response_format=json_schema` 三家行为互不相同，而 langchain-openai 的
#       with_structured_output 默认正是 json_schema ⇒ 见 applications/agent_server/agent/router.py 的待拍板项⑦。
#   ① 魔搭 ModelScope（126 现网在用）：**按模型**——
#      · deepseek-ai/DeepSeek-V4.1-Flash（现网这颗）：不支持 json_schema（稳定 400）；tools 3/3 合规、2–3s、路由判对 rag
#      · Qwen/Qwen3.8-Flash-Next：json_schema 3/3 合规（langchain 默认就能跑通），tools 不接受 tool_choice=required（只有 auto 可用）
#        但用真实 router prompt 同构实测 6 条演示问题只判对 4/6（现网 DeepSeek+tools 判对 6/6，纯词表 5/6）
#        ⇒ "零代码换 Qwen"看着省事，实际把路由质量换低了，且错的那条落进 search（本部署联网未配置）死路
#      ⇒ 同端点两颗模型需要**相反**的方法，换模型就可能静默退回词表——这是要加能力灯的实测依据
#      LLM_BASE_URL=https://api-inference.modelscope.cn/v1
#      LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#   ② 硅基流动：json_schema 名义支持但 5 次里 3 次 75s 读超时；tools 5/5 合规但 8.6–14.4s、路由偏 search
#      （它在本案的既定位置是 embedding/rerank：SILICONFLOW_API_KEY，不是 LLM 主链路）
#      LLM_BASE_URL=https://api.siliconflow.cn/v1
#      LLM_MODEL=Qwen/Qwen3-8B
#   ③ OpenRouter：json_schema 按模型（有的 2/2 合规、有的直接 400）；免费池受上游凭据失效与限流支配
#      LLM_BASE_URL=https://openrouter.ai/api/v1
#      LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# 矩阵与失败分类全文：docs/plans/plan-router-keyword-gate-hides-corpus-2026-10-12.md §8/§10/§11。
# ⚠️ LLM_FALLBACK_MODEL 若与 LLM_MODEL 同名 = 没有备（126 现状如此）；且结构化出参恒绑 primary，降级不走 fallback。

# --- 上下文窗口（务必按实际模型填写，勿用万能默认值） ---
# 单位：token。用于压缩触发阈值（model_context_window * compaction_threshold_ratio）。
# OpenAI 系（gpt-4o=128000, gpt-4-turbo=128000, o1=200000 等）；
# 国产 qwen 系需按所选模型填真实窗口（qwen-max=32768, qwen-long=1000000 等），
# 否则压缩触发比例会与真实窗口脱节，导致永不触发或过早触发。
# 留空则用代码默认 128000。
MODEL_CONTEXT_WINDOW=
# 超过窗口该比例即触发旧消息摘要压缩（0~1）。留空默认 0.8。
COMPACTION_THRESHOLD_RATIO=
# P2.1：主模型输入窗口上限（tokens），直接驱动 deepagents SummarizationMiddleware 阈值。
# 留空则按主模型名自动映射（qwen-max=30000, qwen-long=1000000, gpt-4o=120000 等）。
# 设置后，summarize 按「窗口比例（0.85 触发 / 0.10 保留）」自适应，
# 避免小窗口模型（如 qwen-max 32K）下摘要永不触发。
LLM_MAX_INPUT_TOKENS=

# --- Embedding ---
# auto: 有 EMBEDDING_API_KEY 走远端，否则走内置确定性 mock（仅开发/测试）
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-small-zh

# --- 联网搜索（Tavily；留空则 search 子图返回"未配置"） ---
SEARCH_API_KEY=

# --- Text-to-SQL 业务库（只读执行；支持 sqlite:/// 与 postgresql://，MySQL 留待 Phase 2） ---
SQL_DSN=
SQL_MAX_ROWS=100

# --- 语义缓存 / 长期记忆 / 熔断 ---
CACHE_ENABLED=true
CACHE_THRESHOLD=0.05
MEMORY_ENABLED=true
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_SECONDS=30

# --- Langfuse（可选；均填写才启用 trace 上报） ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RAG ---
RAG_TOP_K=4

# --- Phase 2: 会话并发协调 ---
COORDINATION_ENABLED=true
COORDINATION_POLICY=queue        # coalesce | queue | reject

# --- Phase 2: durable admission（opt-in，默认 false）---
ADMISSION_ENABLED=false
ADMISSION_QUEUE_CAPACITY=100
ADMISSION_QUEUE_TIMEOUT_SECONDS=10.0
ADMISSION_RATE_LIMIT_PER_USER=10
ADMISSION_RATE_LIMIT_PER_SESSION=10
ADMISSION_RATE_LIMIT_GLOBAL=100

# --- Phase 2: 会话回退 revert ---
REVERT_ENABLED=true

# --- Phase 2: OTel 接线（opt-in，默认 false）---
OTEL_ENABLED=false
OTEL_EXPORTER=otlp               # otlp | jaeger | console | none
OTEL_ENDPOINT=
OTEL_SAMPLING_RATE=1.0
OTEL_SERVICE_NAME=agent-platform

# --- Phase 2: MCP client（opt-in，默认 false）---
MCP_ENABLED=false
MCP_SERVERS=                      # JSON 编码的 server 配置列表

# --- CORS：允许的前端来源（逗号分隔），为空时默认回环 127.0.0.1:5173 ---
CORS_ALLOW_ORIGINS=

# ===== agent_server（supervisor 平台）模板补齐（2026-10-16）=====
# 以下 43 个键代码一直在读、此前无任何 .env.example 记载（口径：Settings.model_fields 87 个
# 字段逐个比对根模板 active 键；`git grep -w` 对全仓 6 份 .env.example 零命中）。
# 键名 = 字段名大写：config.py 与 shared_schemas/settings.py 均无 env_prefix、无 alias。
# 值一律照代码里的 Field 默认，注释复用 config.py 原话。钉桩用例：
# tests/governance/test_agent_server_env_template.py

# --- 存储 / 服务端租户断言 ---
DB_POOL_MAX_SIZE=20              # 连接池上限（高并发 admission 全局限流 100/s 时避免池耗尽）
DEFAULT_TENANT_ID=default        # 隔离域（ADR-0006）：/import、/sql/train 等无请求体租户的写入口
                                 # 经 server_tenant_id() 解析：请求链路 ContextVar 优先，其次本配置。
                                 # 单租户部署显式保持 default；多租户部署必须按部署单元注入真实租户。

# --- Embedding ---
VECTOR_DIM=512                   # 代码默认 512（BaseLLMSettings）

# --- Rerank：RRF 融合后是否用硅基流动 bge-reranker-v2-m3 重排 top-K ---
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=8                   # 融合后送入 rerank 的候选数（>= RAG_TOP_K）

# --- 长期记忆（优化 H） ---
MEMORY_EXTRACTION_ENABLED=false  # LLM 抽取结构化事实（默认关，无 LLM 时退化存原文）
MEMORY_FORGET_THRESHOLD=0.1      # 低价值记忆惰性淘汰阈值（importance）

# --- 图控制 / 上下文压缩 ---
MAX_ITERATIONS=2
COMPACTION_ENABLED=true

# --- 输入护栏（opt-in，默认 false）：PII 脱敏 + prompt injection 检测 ---
GUARD_ENABLED=false

# --- Planner 实现选择（deterministic | graph | agentic | auto） ---
PLANNER=deterministic            # auto 启用 Phase A Mode Selector：按问题/能力自动选
                                 # deterministic/workflow/graph/agentic；其余值为强制 override（调试/灰度）

# --- Plan-F Phase 3: Skill 组合治理（agentic 组合路径的护栏边界；deterministic 静态 DAG 天然无环，不使用这些限制） ---
MAX_SKILL_DEPTH=4
MAX_STEPS=20
ENABLE_LOOP_FINGERPRINT=false    # P5-1：语义循环指纹（skill + 归一化 args），重复指纹拒绝继续
                                 # （默认关，避免误伤合法重放/重规划）
MAX_EXECUTION_SECONDS=60.0       # 单次 execution 的 wall-clock 上限（秒），None/0 不启用

# --- Plan-F Context Pipeline：统一上下文组装（agent_runtime/context/） ---
CONTEXT_BUDGET_TOOL_RESULTS_RATIO=0.35  # tool_results 层占比
TOOL_RESULT_MAX_TOKENS=8192      # 单条工具结果超此阈值则外置 + 截断视图
TOOL_RESULT_STORE_DIR=           # 空则复用 session_dir
MEMORY_GATE_TOP_K=5              # 记忆召回门控：预算内最多注入的条数
TOOL_RESULT_COMPRESSION_ENABLED=false  # opt-in：Skill 出口统一压缩（默认关，避免改变现有返回结构）

# --- Remote Skill 端点（P1：重服务 HTTP 调用） ---
KNOWLEDGE_SERVICE_URL=           # 空 = 不注册 knowledge skill
KNOWLEDGE_SERVICE_KEY=
NL2SQL_SERVICE_URL=              # 空 = 不注册 nl2sql skill
KEFU_SERVICE_URL=                # 空 = 不注册 kefu skill
EXHIBITION_SERVICE_URL=          # 空 = 不注册 exhibition skill（G4）

# --- §20: 运行时模式（决定持久化后端与 fail-fast 行为） ---
RUNTIME_MODE=local               # local -> InMemory 后端，无需 DATABASE_URL（开发/测试默认）
                                 # single_node -> PG 可选（有 DATABASE_URL 用 PG，无则降级 InMemory）
                                 # distributed -> PG 必须（无 DATABASE_URL 启动即报错，fail fast）

# --- V3 Phase 2: ExecutionScheduler（opt-in，默认关） ---
SCHEDULER_ENABLED=false          # 启用后请求过 Queue -> Dispatch -> Execute，未启用时走原路径
SCHEDULER_MAX_CONCURRENT=10
SCHEDULER_MAX_CONCURRENT_PER_TENANT=5
SCHEDULER_QUEUE_CAPACITY=1000
SCHEDULER_RECOVERY_ENABLED=false # lease 失效执行的恢复决策（retry/query/fail/human）。默认关：开启后
                                 # Rescheduler 会向队列新入 :retry:N 请求，重试消耗队列容量（QueueFull
                                 # 时静默失败）。关闭时 Reaper 逐字保持旧行为（只标 FAILED + 释放 slot）
SCHEDULER_RECOVERY_MAX_RETRIES=3

# --- V3-6 Layer B: 大 payload 外部化（opt-in，默认关） ---
PAYLOAD_EXTERNALIZATION_ENABLED=false
PAYLOAD_EXTERNALIZATION_DIR=     # enabled=true 时必须同时给 dir，否则启动即 fail-fast
                                 # （见 main._build_payload_externalizer）
PAYLOAD_EXTERNALIZATION_THRESHOLD_BYTES=1048576  # 代码默认 1024 * 1024

# --- V3 Phase 4: Cost Governance（opt-in，默认关；启用后请求路径加 budget check/record，超限返回 429） ---
COST_GOVERNANCE_ENABLED=false
BUDGET_LIMIT_REQUESTS=0          # 0 = 不限制
BUDGET_LIMIT_TOKENS=0
BUDGET_LIMIT_COST=0.0
BUDGET_WINDOW_SECONDS=3600.0
