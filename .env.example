# ===== agent-platform 环境变量模板 =====
# 复制为 .env 后填值；切勿提交真实 .env

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
# 启用后所有接口需 X-API-Key 头；同时忽略客户端传入的 thread_id（防会话劫持）
API_KEY=
# 会话身份不再从 API_KEY 派生（B7b 已拆三条「凭据→摘要」链）：启用鉴权时取
# 服务端断言的主体（见下方 SINGLE_TENANT / 验签公钥），历史旧格式会话由
# scripts/migrate_thread_identity.py 枚举式重挂（无需任何密钥参与）。

# --- 租户身份断言（ADR-0007 A3/A4；均走密钥库/挂载，真实值绝不提交）---
# 部署级令牌：既无验签公钥又未声明 SINGLE_TENANT 且 DEPLOY_ENFORCE_IDENTITY=true → 拒绝启动。
DEPLOY_ENFORCE_IDENTITY=false      # 生产置 true 开启 fail-fast；开发/测试默认 false
SINGLE_TENANT=                     # 单租户部署显式声明（非空即绑定该租户，封死"未配key不校验"旁路）
# 验签公钥 JSON {"<kid>": "<PEM>"}（可多把并存支持轮转；子服务/网关验签用，公钥本身可公开）
TENANT_JWT_PUBLIC_KEYS_FILE=
# 签发私钥（仅 issuer=网关持有！绝不下发子服务，绝不进仓库）
TENANT_JWT_PRIVATE_KEY_FILE=
TENANT_JWT_ISSUER=agent-gateway
TENANT_JWT_AUDIENCE=agent-platform
TENANT_JWT_CLOCK_SKEW=60
TENANT_JWT_MAX_TTL_S=3600
TENANT_JWT_ENFORCE=false           # true：无凭据请求 401（灰度末硬切换）；false=observe 放行
# 网关→子服务内部签名头（HMAC-SHA256，共享对称密钥，独立于 API_KEY）
INTERNAL_HMAC_KEY_FILE=
INTERNAL_HEADER_MAX_AGE_S=300
TENANT_HEADER_ENFORCE=false        # A4 观测期软模式；A6 灰度末切 true（fail-closed 拒缺失头）

# --- 存储（留空则以内存模式运行，仅开发用，无持久化） ---
# PostgreSQL + pgvector，承载 checkpoint / RAG 分块 / 长期记忆 / 语义缓存 / SQL 训练数据
DATABASE_URL=postgresql://agent:agent_platform_dev@localhost:5432/agent_platform
# 内核 pg 记忆/联邦池专用（WS-5）：缺省回退 DATABASE_URL；
# 旧名 DEEPAGENTS_DATABASE_URL 兼容一个小版本（命中时触发弃用警告）
# AGENT_PLATFORM_DATABASE_URL=
# 向量维度由 Embedding Provider 自动派生（bge-small-zh=512, bge-m3=1024）。
# 仅当使用 mock 模式或需要显式覆盖时才需设置 EMBEDDING_DIM。
# EMBEDDING_DIM=512
# P2.2：deepagents 长期记忆 store 专用连接串（pgvector 语义记忆，跨会话语义检索）。
# 留空则 deepagents 用 InMemoryStore（重启丢，开发态）。生产需配独立 PG（或复用 DATABASE_URL）。
# 索引维度由 agent-core embedder 动态派生（get_embedder().dim）。
STORE_POSTGRES_DSN=

# --- LLM（OpenAI 兼容协议；留空则以无 LLM 模式运行，路由走启发式） ---
# 权威名：LLM_API_KEY / LLM_BASE_URL（全平台统一，federation 与 knowledge-service 均读此名）。
# 兼容别名：OPENAI_API_KEY / OPENAI_BASE_URL 仍可用（当 LLM_* 未设置时回退），便于平滑迁移。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# --- 上下文窗口（务必按实际模型填写，勿用万能默认值） ---
# 单位：token。用于压缩触发阈值（model_context_window * compaction_threshold_ratio）。
# OpenAI 系（gpt-4o=128000, gpt-4-turbo=128000, o1=200000 等）；
# 国产 qwen 系需按所选模型填真实窗口（qwen-max=32768, qwen-long=1000000 等），
# 否则压缩触发比例会与真实窗口脱节，导致永不触发或过早触发。
# 留空则用代码默认 128000。
MODEL_CONTEXT_WINDOW=
# 超过窗口该比例即触发旧消息摘要压缩（0~1）。留空默认 0.8。
COMPACTION_THRESHOLD_RATIO=
# P2.1：主模型输入窗口上限（tokens），直接驱动 deepagents SummarizationMiddleware 阈值。
# 留空则按主模型名自动映射（qwen-max=30000, qwen-long=1000000, gpt-4o=120000 等）。
# 设置后，summarize 按「窗口比例（0.85 触发 / 0.10 保留）」自适应，
# 避免小窗口模型（如 qwen-max 32K）下摘要永不触发。
LLM_MAX_INPUT_TOKENS=

# --- Embedding ---
# auto: 有 EMBEDDING_API_KEY 走远端，否则走内置确定性 mock（仅开发/测试）
EMBEDDING_MODE=auto
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-small-zh

# --- 联网搜索（Tavily；留空则 search 子图返回"未配置"） ---
SEARCH_API_KEY=

# --- Text-to-SQL 业务库（只读执行；支持 sqlite:/// 与 postgresql://，MySQL 留待 Phase 2） ---
SQL_DSN=
SQL_MAX_ROWS=100

# --- 语义缓存 / 长期记忆 / 熔断 ---
CACHE_ENABLED=true
CACHE_THRESHOLD=0.05
MEMORY_ENABLED=true
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_SECONDS=30

# --- Langfuse（可选；均填写才启用 trace 上报） ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RAG ---
RAG_TOP_K=4

# --- Phase 2: 会话并发协调 ---
COORDINATION_ENABLED=true
COORDINATION_POLICY=queue        # coalesce | queue | reject

# --- Phase 2: durable admission（opt-in，默认 false）---
ADMISSION_ENABLED=false
ADMISSION_QUEUE_CAPACITY=100
ADMISSION_QUEUE_TIMEOUT_SECONDS=10.0
ADMISSION_RATE_LIMIT_PER_USER=10
ADMISSION_RATE_LIMIT_PER_SESSION=10
ADMISSION_RATE_LIMIT_GLOBAL=100

# --- Phase 2: 会话回退 revert ---
REVERT_ENABLED=true

# --- Phase 2: OTel 接线（opt-in，默认 false）---
OTEL_ENABLED=false
OTEL_EXPORTER=otlp               # otlp | jaeger | console | none
OTEL_ENDPOINT=
OTEL_SAMPLING_RATE=1.0
OTEL_SERVICE_NAME=agent-platform

# --- Phase 2: MCP client（opt-in，默认 false）---
MCP_ENABLED=false
MCP_SERVERS=                      # JSON 编码的 server 配置列表

# --- CORS：允许的前端来源（逗号分隔），为空时默认回环 127.0.0.1:5173 ---
CORS_ALLOW_ORIGINS=
