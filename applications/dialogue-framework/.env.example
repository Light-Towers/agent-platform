# dialogue-framework 环境变量（占位符，使用前填值，不含真实密钥）
# .env 不入库，由 .gitignore 忽略

# 存储后端：json（开发零依赖）| postgres（生产）
STORE_BACKEND=json
# Postgres DSN（STORE_BACKEND=postgres 时必填）
DATABASE_URL=

# 检索后端
RETRIEVAL_BACKEND=pgvector
# 图检索后端（可插拔）：pgvector | neo4j
GRAPH_BACKEND=pgvector

# LLM 提供方
LLM_PROVIDER=langchain_openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding 后端（可插拔）：langchain_openai | langchain_huggingface
EMBEDDING_BACKEND=langchain_openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-zh

# 服务
HOST=0.0.0.0
PORT=8001
