# exhibition-agent 环境变量示例
# 复制为 .env 并填入实际值

# LLM 配置
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 仓库 API
WAREHOUSE_BASE_URL=http://127.0.0.1:8000
EXHIBITION_API_BASE_URL=http://127.0.0.1:8000

# Skill 配置
SKILL_MD_PATH=
TOOL_RESULT_MAX_CHARS=8000
MAX_TOOL_ROUNDS=6

# 下游服务（P2-5：skills/data_analysis/skill.py:33 读取 NL2SQL_SERVICE_URL，此前未在模板声明）
# 代码内回退默认为 http://localhost:8000；此处指向 nl2sql-service 模板端口 8002。
NL2SQL_SERVICE_URL=http://localhost:8002

# 运行模式（DEMO / PRODUCTION）：影响 SYNTHETIC Tool 是否允许进入生产链路
AGENT_MODE=DEMO

# ==================== 生产 Settings（部署入口 exhibition_agent.server:app）====================
# 下列变量由 exhibition_agent/config.py 的 pydantic Settings 读取，统一前缀
# EXHIBITION_AGENT_（env_prefix）。与上方 skill_loader 演示入口（无前缀、os.environ 直读）
# 是两套配置面：部署 `uvicorn exhibition_agent.server:app` 时生效的是这一组。
# 每项默认值 1:1 取自 config.py 的 Field(default=...)，未在此杜撰任何变量。

# warehouse 领域 API 基址（mock 默认 9100；接真实 warehouse 改此值）
EXHIBITION_AGENT_WAREHOUSE_BASE_URL=http://127.0.0.1:9100
# ExecutionContext 传递模式：jwt（默认 D1）| base64
EXHIBITION_AGENT_CONTEXT_MODE=jwt
# 执行档位（契约 v1.1 §C1）：STRICT（生产，验签）| DEV（本地/测试，不验签）；无 OFF 档
EXHIBITION_AGENT_EXECUTION_MODE=DEV
# JWT 验签密钥（STRICT 档必填，DEV 档留空）
EXHIBITION_AGENT_CONTEXT_JWT_SECRET=
# warehouse 调用超时（秒）
EXHIBITION_AGENT_WAREHOUSE_TIMEOUT=10.0
# 日志级别
EXHIBITION_AGENT_LOG_LEVEL=INFO
# OTLP 导出端点（空 → no-op 降级，本地/CI 无 collector 也全绿）
EXHIBITION_AGENT_OTEL_ENDPOINT=
# OTel service.name 属性
EXHIBITION_AGENT_OTEL_SERVICE_NAME=exhibition-agent
# OTel 总开关（需 endpoint 非空 + SDK 可用才真实导出）
EXHIBITION_AGENT_OTEL_ENABLED=false
# LLM 可观测后端：langfuse（默认，开源 MIT）| langsmith（商业闭源）| noop
EXHIBITION_AGENT_LLM_OBS_BACKEND=langfuse
