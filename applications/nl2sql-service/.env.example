# wenda-data-agent 环境变量（占位符，使用前填值，不含真实密钥）
# .env 不入库，由 .gitignore 忽略

# 元知识库 Postgres DSN
META_DB_DSN=
# 业务数仓 Postgres DSN（只读执行）
DW_DB_DSN=

# Embedding 后端（可插拔）：langchain_openai | langchain_huggingface
EMBEDDING_BACKEND=langchain_openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-zh

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# SQL 只读守卫（强制 true）
SQL_READ_ONLY_GUARD=true
# 分词器：bigram | jieba
TOKENIZER=bigram

# 服务
HOST=0.0.0.0
PORT=8002
