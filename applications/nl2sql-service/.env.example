# nl2sql-service 环境变量（占位符，使用前填值，不含真实密钥）
# .env 不入库，由 .gitignore 忽略

# 元知识库 Postgres DSN
META_DB_DSN=
# 业务数仓 Postgres DSN（只读执行）
DW_DB_DSN=

# Embedding 后端（可插拔）：langchain_openai | langchain_huggingface
EMBEDDING_BACKEND=langchain_openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 模型必须与 VECTOR_DIM 匹配（text-embedding-3-small=1536 维）。
# 换 bge-* 等模型时须同步改 VECTOR_DIM 并全库重灌——维度不符时 pgvector 插入直接报错。
EMBEDDING_MODEL=text-embedding-3-small

# LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# SQL 只读守卫（强制 true）
SQL_READ_ONLY_GUARD=true
# 分词器：bigram | jieba
TOKENIZER=bigram

# --- 取值只读探针（P0-9/P0-7）---
# 取值匹配的唯一源侧入口：生成后核验字面量，召回阶段零源查询。
VALUE_PROBE_ENABLED=true
# 单次探针返回值上限
VALUE_PROBE_LIMIT=50
# 单次探针语句超时（毫秒；事务内 SET LOCAL，退出即撤，不污染池连接）
VALUE_PROBE_TIMEOUT_MS=2000
# 探针并发上限（信号量）
VALUE_PROBE_CONCURRENCY=2
# 探针缓存 TTL（秒）：键含 source_snapshot，版本不变即命中
VALUE_PROBE_CACHE_TTL_SECONDS=900
# 源数据版本 SQL（Doris 最新分区号 / MySQL 水位）；空 = TTL 分桶兜底
SOURCE_SNAPSHOT_SQL=
# 分区谓词（Doris 场景必配）：配了分区列，最新分区值取不到就不探（不做全分区扫描）
DW_PARTITION_COLUMN=
DW_LATEST_PARTITION_SQL=
DW_PARTITION_REQUIRED=true
# P1-2 linkable 白名单（"table.column" 全限定名，逗号分隔）；空 = 全关。
# 枚举/城市/行业开；UUID/时间戳/手机号/长文本一律关（类型闸门，记录原因）
LINKABLE_COLUMNS=

# 服务
HOST=0.0.0.0
# 代码默认 8000（conf/settings.py:16）；本模板取 8002 以避开与 agent_server 的 8000 冲突。
# 二者不一致为刻意区分（独立端口），非笔误——见 arch-audit-2026-09-24.md P1-10。
PORT=8002

# ===== nl2sql-service 模板补齐（2026-10-16）=====
# 以下 12 个键是 `conf/settings.py::Settings`（含继承 shared_schemas.BaseLLMSettings 的部分）
# 实际会读、而本模板此前没记载的键 —— 照模板部署时它们一直静默取代码默认值。
# 每项默认值 1:1 取自 Field 默认 / 类属性赋值，未杜撰；一致性由
# tests/test_env_template.py 钉住（正向齐全 + 段内值等）。

# --- LLM 补充（BaseLLMSettings + 本服务覆盖）---
# 请求超时（秒）
LLM_TIMEOUT=60.0
# 失败重试次数
LLM_MAX_RETRIES=3

# --- 向量/检索（本服务覆盖基类默认 512）---
# 向量维度：本服务取 1536，覆盖 BaseLLMSettings 的 512
VECTOR_DIM=1536
# 元知识召回条数（区别于 agent_server=4 / knowledge=5：专用 Text-to-SQL 需广泛覆盖表/列/指标）
RETRIEVAL_TOP_K=10
# RRF 融合常数
RRF_K=60
# 向量召回相对截断（P0-5④）：与最佳分的差超过 margin 即截断；0 = 关闭（纯 top-k）
RETRIEVAL_SCORE_MARGIN=0.15

# --- SQL 守卫 ---
# 单次查询返回行数上限（区别于 agent_server=100：结果给前端 UI 展示，不注入 LLM prompt）
SQL_MAX_ROWS=1000
# 语法/执行错误后的重写次数
SQL_MAX_CORRECT_RETRIES=3
# 进模型的结果体量上限（§5.11-V3 双上限分离）：与 SQL_MAX_ROWS（返回 UI）分开，
# 超过任一上限走"汇总统计 + 前 N 行样例"而非裸截断
SQL_MAX_ROWS_FOR_PROMPT=100
SQL_PROMPT_MAX_BYTES=51200
# 候选表行数估值超过该值时，生成 prompt 追加"优先聚合"引导（估值来自 P0-3 漂移检测）
AGGREGATION_ROW_THRESHOLD=1000000
# 元知识表名前缀
TABLE_PREFIX=nl2sql_

# 生成期日期上下文的口径说明（P0-11①）：系统日期由代码注入，这里声明数据新鲜度。
# 例：数据为 T+1 快照，按数据日期理解"今天/昨天"。留空 = 只注入系统日期。
DATE_CONTEXT_NOTE=

# --- 连接池配额（2026-10-18 起走共享件 agent_runtime.pool_factory；配额口径见方案 §5.12.2）---
# 元知识库池下限：按需增长，不预占（psycopg 默认 4 会在启动就占 4 个后端）
META_DB_POOL_MIN_SIZE=1
# 元知识库池上限：对齐 agent_runtime.db 的 db_pool_max_size 默认 20
META_DB_POOL_MAX_SIZE=20
# 元知识库池取连接等待上限（秒）
META_DB_POOL_TIMEOUT=5.0
# 元知识库单语句超时（毫秒）：检索/写入均应毫秒级，超过即缺 ANN 索引
META_DB_STATEMENT_TIMEOUT_MS=5000
# 业务数仓池下限
DW_DB_POOL_MIN_SIZE=1
# 业务数仓池上限：OLAP 查询长而少，且将打 Doris/MySQL，连接更贵
DW_DB_POOL_MAX_SIZE=10
# 业务数仓池取连接等待上限（秒）
DW_DB_POOL_TIMEOUT=10.0
# 业务数仓单语句超时（毫秒）：聚合扫描可合法跑数十秒，护栏是 LIMIT + 连接级只读
DW_DB_STATEMENT_TIMEOUT_MS=30000
# 业务数仓池连接级只读：固定 true，不设开关（第二道防线，勿退回首道 SET）
DW_DB_CONNECTION_READ_ONLY=true

# --- Rerank ---
# 2026-10-18（S-9 定性修正）：这四个键是 shared_schemas.BaseLLMSettings 的继承字段，
# 由 knowledge-service / agent_server 真实消费；**nl2sql-service 自己不消费**
# （本服务检索层无 rerank 节点）。保留记载是因为 env 模板门禁要求每个 Settings
# 字段可查——删键会让门禁红，且掩盖"继承但不用"的事实。置值对本服务无效。
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
