# RAGFlow / 知识库配置（改造后改调 zhiku）
ZHIKU_API_URL=http://localhost:8900
ZHIKU_API_KEY=<YOUR_ZHIKU_KEY>

# LLM 配置（主模型）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-<YOUR_DASHSCOPE_KEY>
LLM_QWEN_MAX=qwen-max

# LLM 备用模型（可选，主模型不可用时自动降级）
# 留空则不启用 fallback
OPENAI_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_FALLBACK_API_KEY=sk-<YOUR_DASHSCOPE_KEY>
LLM_QWEN_FALLBACK=qwen-plus

# Tavily 搜索
TAVILY_API_KEY=tvly-<YOUR_TAVILY_KEY>

# 数据库配置（生产环境应使用只读用户）
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=pharma_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
# 连接池配置（可选，SQLAlchemy QueuePool + pymysql）
# MYSQL_POOL_SIZE=5
# MYSQL_POOL_MAX_OVERFLOW=2
# MYSQL_POOL_RECYCLE=3600

# 安全配置
API_KEY=<YOUR_API_KEY>
ALLOWED_ORIGINS=http://localhost:3000
MAX_CONCURRENT_TASKS=10

# Langfuse 可观测（可选，未配则走 agent-core OTel no-op 降级）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=sk-lf-<YOUR_LANGFUSE_SECRET_KEY>

# Valkey 语义缓存（可选，未配则不启用缓存）
VALKEY_URL=redis://localhost:6379

# 子服务地址（联邦网关用）
# wenda-adapter 已退役，Text-to-SQL 直连 wenda-data-agent
WENDA_DATA_AGENT_URL=http://localhost:8000
KEFU_ADAPTER_URL=http://localhost:8002

# Phase 3：意图识别 + 改写（可选，默认关闭）
# INTENT_ENABLED=true

# Phase 4：思考规划 + Reflexion（可选，默认关闭）
# PLANNER_ENABLED=true
# REFLEXION_ENABLED=true

# Phase 5：语义缓存（可选，默认关闭）
# CACHE_ENABLED=true

# ==========================================================================
# 记忆架构（会话历史 + 语义长期记忆）
# ==========================================================================

# --- 会话历史持久化（MongoDB，替代内存 checkpointer）---
# 配置 MONGO_URL 即启用 MongoCheckpointer；未配置则降级 InMemorySaver（重启丢）。
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=deepagents
# MONGO_CHECKPOINT_COLLECTION=langgraph_checkpoints

# --- 语义长期记忆（向量存储，可切换后端）---
# 总开关（默认 false，开启才写入/召回）
# SEMANTIC_MEMORY_ENABLED=true
# 向量后端：milvus（默认） | pg（PostgreSQL + pgvector 备选）
# VECTOR_BACKEND=milvus
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# pg 备选用：DEEPAGENTS_DATABASE_URL=postgresql://user:pass@localhost:5432/deepagents

# --- Embedding 来源（动态切换，无需改代码）---
# 配置了 SILICONFLOW_API_KEY → 远程硅基流动 API（默认 BAAI/bge-m3，1024 维）
# 未配置                   → 本地 sentence-transformers（BAAI/bge-small-zh-v1.5，512 维）
# SILICONFLOW_API_KEY=sk-<YOUR_SILICONFLOW_KEY>
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# 本地模型覆盖（仅本地模式生效）：INTENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==========================================================================
# 能力开关与治理（审查补全：TB-11 短期建议）
# 以下均经 grep 核对 deepagents 源码真实存在，默认值取自代码中 os.getenv 第二参数。
# ==========================================================================

# --- 运行模式 ---
# AGENT_MODE：deepagents 运行模式，取值为 local / remote（非 gateway/standalone）
# AGENT_MODE=local

# --- 鉴权与限流（server.py / gateway/rate_limit.py） ---
# DISABLE_AUTH：关闭 API Key 鉴权（安全敏感！默认 false；仅本地联调使用）
# DISABLE_AUTH=false
# RATE_LIMIT_PER_CLIENT：单客户端并发上限（SecurityGuardsMiddleware，默认 30）
# RATE_LIMIT_PER_CLIENT=30
# RATE_LIMIT_GLOBAL：全局并发上限（默认 200）
# RATE_LIMIT_GLOBAL=200
# RATE_LIMIT_RPM：网关每客户端每分钟请求数（默认 60）
# RATE_LIMIT_RPM=60
# RATE_LIMIT_BURST：网关突发容量（默认 10）
# RATE_LIMIT_BURST=10

# --- 输入护栏（agent_core.guardrails / tools/sql_guard.py） ---
# GUARD_ENABLED：是否启用输入护栏（默认 false）
# GUARD_ENABLED=true
# USE_CORE_GUARD：是否委托 agent_core 内核护栏（默认 on）
# USE_CORE_GUARD=on
# SQL_GUARD_MAX_ROWS：SQL 守卫单次查询最大返回行数（默认 100）
# SQL_GUARD_MAX_ROWS=100

# --- 联邦契约断言（P4.1 灰度开关，main_agent.py / async_subagents.py） ---
# E1_CONTRACT_ASSERT：断言远程响应符合 shared_schemas.QueryResponse 形状（默认 on）
# E1_CONTRACT_ASSERT=on
# E1_CONTENT_ASSERT：断言响应 answer 非空（与形状断言分离，可独立回滚，默认 on）
# E1_CONTENT_ASSERT=on

# --- 子服务委派治理（P3，async_subagents.py） ---
# SUBAGENT_RETRIES：委派远程子 agent 失败重试次数（默认 2）
# SUBAGENT_RETRIES=2
# SUBAGENT_RETRY_BASE：重试退避基数秒（默认 1.0）
# SUBAGENT_RETRY_BASE=1.0
# 灰度发布比例：GRAY_PCT（0-100，按请求哈希分流新策略，默认 0）
# GRAY_PCT=0

# --- 动态 agent 配置（main_agent.py） ---
# DYNAMIC_AGENT_ENABLED：是否从配置中心/DB 动态加载子 agent 定义（默认 false）
# DYNAMIC_AGENT_ENABLED=false
# DYNAMIC_AGENT_CACHE_MAX：动态 agent 角色 LRU 缓存容量（默认 10）
# DYNAMIC_AGENT_CACHE_MAX=10

# --- 记忆 / 语义存储后端（main_agent.py） ---
# STORE_POSTGRES_DSN：语义记忆 PostgreSQL DSN（空则不启用 PG 后端）
# STORE_POSTGRES_DSN=postgresql://user:pass@localhost:5432/deepagents
# STORE_EMBED_DIMS：语义记忆向量维度（默认 512）
# STORE_EMBED_DIMS=512

# --- Checkpoint 清理（agent/checkpoint_cleaner.py） ---
# CHECKPOINT_KEEP_PER_THREAD：每会话保留的最近 checkpoint 数（默认 5）
# CHECKPOINT_KEEP_PER_THREAD=5
# CHECKPOINT_RETENTION_HOURS：checkpoint 保留时长小时（默认 6，过期清理）
# CHECKPOINT_RETENTION_HOURS=6
