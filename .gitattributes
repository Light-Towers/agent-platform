# Normalize to LF
* text=auto eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Code
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary

# Archives
*.zip binary
*.tar binary
*.gz binary
