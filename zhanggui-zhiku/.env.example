# ============================================================
# 掌柜智库（Zhanggui Zhiku）环境变量示例
# 复制本文件为 .env 后按需修改；所有地址默认指向本地（localhost）。
# 真实密钥/内网地址请勿提交到仓库（.env 已被 .gitignore 忽略）。
# ============================================================

# -------------------------- 应用 --------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# PROJECT_ROOT 留空则自动取仓库根目录；容器/特殊部署时可显式指定绝对路径
PROJECT_ROOT=
CORS_ORIGINS=http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# -------------------------- 模型 / 路径 --------------------------
# 模型与缓存根目录（BGE-M3、Reranker、modelscope、huggingface 缓存均在其下）
MODELS_DIR=./models
# 以下四个派生路径留空时，由 app.core.config 按 MODELS_DIR 自动推导
MODELSCOPE_CACHE=
HF_HOME=
BGE_M3_PATH=
BGE_RERANKER_LARGE=
MD_ROOT_DIR=./temp-files
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1

# -------------------------- LLM --------------------------
# OpenAI 兼容 API 基础地址与密钥（千问/即梦等国产模型也走此兼容协议）
OPENAI_BASE_URL=
OPENAI_API_KEY=your-key-here
VL_MODEL=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0.7
ITEM_NAME_DIAG=1

# -------------------------- Embedding --------------------------
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0

# -------------------------- Milvus --------------------------
MILVUS_URL=http://localhost:19530
# 兼容保留：仅当需要沿用既有旧集合（如 kb_chunks）时才取消注释并显式设置；
# 默认使用版本化集合名 {MILVUS_COLLECTION_PREFIX}_{MILVUS_SCHEMA_VERSION}_{embedding_model}，
# 例如 product_manual_v1_bge_m3（M2 索引生命周期版本化）
# CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024
# M2：索引集合版本化命名与 chunk 元数据版本
MILVUS_COLLECTION_PREFIX=product_manual
MILVUS_SCHEMA_VERSION=v1
CHUNK_VERSION=v1-title-aware

# -------------------------- Neo4j --------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456

# -------------------------- Mongo --------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=zhanggui-zhiku

# -------------------------- MinIO --------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=kb-import-bucket
MINIO_IMG_DIR=images
MINIO_SECURE=False
MINIO_PDF_DIR=pdf_files

# -------------------------- Reranker --------------------------
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# -------------------------- 硅基流动 API 模式（M8） --------------------------
# 无 GPU / 未安装本地模型（FlagEmbedding、pymilvus.model）时，可把 embedding / rerank
# 切换到硅基流动 OpenAI 兼容 API，无需本地模型即可完整跑通导入与检索。
#   EMBEDDING_MODE=local（默认，行为与之前完全一致，本地 BGE-M3 稠密+稀疏双路）
#   EMBEDDING_MODE=api   （稠密走硅基流动 /embeddings，稀疏由本地 sparse_vectorizer 生成）
#   RERANK_MODE=local（默认，本地 FlagReranker）
#   RERANK_MODE=api     （走硅基流动 /rerank）
# 注意：api 模式必须填写 SILICONFLOW_API_KEY，否则启动调用时报错。
EMBEDDING_MODE=local
RERANK_MODE=local
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# -------------------------- MCP / MinerU --------------------------
MCP_DASHSCOPE_BASE_URL=
MINERU_BASE_URL=
MINERU_API_TOKEN=your-key-here

# -------------------------- 日志 --------------------------
LOG_CONSOLE_ENABLE=True
LOG_FILE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# -------------------------- OTel 全链路追踪（M4，方案 §8） --------------------------
# 三个变量置空/关闭时，tracing 自动降级为 no-op（本地无 collector 也能正常运行）：
#   真实导出要求：ZHANGUI_TRACE_ENABLED=true 且 OTEL_EXPORTER_OTLP_ENDPOINT 非空，
#   且已安装可选依赖（uv sync --extra tracing + opentelemetry-exporter-otlp-proto-grpc/http）。
OTEL_EXPORTER_OTLP_ENDPOINT=
ZHANGUI_SERVICE_NAME=zhanggui-zhiku
ZHANGUI_TRACE_ENABLED=false

# -------------------------- 入站安全护栏（M5，方案 §9） --------------------------
# API Key 鉴权：为空则鉴权关闭（保持向后兼容课程原样）；非空时请求需带
# X-API-Key 或 Authorization: Bearer <key>。
# 免鉴权：/health（探针）、/chat.html、/import.html（静态页）、/stream/...（SSE 无法携带自定义头）。
ZHANGUI_API_KEY=
# 入站限流（进程内滑动窗口；多副本部署需外置共享存储，见 CHANGELOG 技术债）
ZHANGUI_RATE_LIMIT_PER_CLIENT=20
ZHANGUI_RATE_LIMIT_GLOBAL=500
ZHANGUI_RATE_LIMIT_WINDOW_S=60
# 输入长度护栏：query 长度上限在 Pydantic 层强制（512 字符，超限 400）；
# 历史轮数超限截断保留最近 N 轮；请求体大小超限 413。
ZHANGUI_MAX_HISTORY_ROUNDS=20
ZHANGUI_MAX_BODY_BYTES=65536
